# 可将以下变量填写到 1Panel 编排的“环境变量”区域，
# 或保存为与 docker-compose.1panel.example.yml 同目录的 docker-compose.1panel.env 文件。
# 此文件仅为示例，禁止把包含真实密码和密钥的环境文件提交到 Git。

# 后端镜像地址。生产环境建议固定 semver 或 sha-* 标签，不要长期跟随 latest。
# 示例：ghcr.io/jacqueshuang-fresnostate/rust-chain:1.2.3
EXCHANGE_IMAGE=ghcr.io/jacqueshuang-fresnostate/rust-chain:latest

# 1Panel 的外部 Docker 网络名称。
# MySQL、MongoDB、Redis、RabbitMQ 和反向代理应加入同一网络；
# 如果第三方服务使用其他外部网络，请改成实际网络名。
# 示例：1panel-network
ONEPANEL_NETWORK=1panel-network

# API 容器名称，可按 1Panel 中的命名规则调整。
# 示例：hippo-exchange-api
API_CONTAINER_NAME=hippo-exchange-api

# 数据库迁移容器名称。该容器迁移成功后正常退出，不需要长期运行。
# 示例：hippo-exchange-migrate
MIGRATE_CONTAINER_NAME=hippo-exchange-migrate

# 管理员引导默认关闭。首次部署需要时临时改为 create_admin，并在 1Panel Secret/环境变量中
# 注入一次性随机口令；也可把 Secret 挂载为文件后填写容器内 BOOTSTRAP_ADMIN_PASSWORD_FILE。
BOOTSTRAP_MODE=disabled
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD_FILE=
BOOTSTRAP_ADMIN_ROLE_NAME=super_admin

# API 绑定到宿主机的地址。
# 1Panel 反向代理访问宿主机端口时保持 127.0.0.1；
# 只有明确需要其他主机直连时才改成 0.0.0.0，并同时配置防火墙。
# 示例：127.0.0.1
API_BIND_ADDRESS=127.0.0.1

# API 映射到宿主机的端口，容器内端口固定为 8080。
# 示例：8080
API_PORT=8080

# 上传文件持久化卷名称，不要在更新编排时随意更换。
# 示例：hippo-exchange-uploads
UPLOADS_VOLUME=hippo-exchange-uploads

# 以下连接地址中的主机名必须替换为 1Panel 实际容器名、网络别名或可访问的内网地址。
# 密码包含 @、:、/、#、% 等特殊字符时必须进行 URL percent-encoding。

# MySQL 完整连接地址，格式：mysql://用户:密码@主机:端口/数据库名
# 示例：mysql://exchange:change-me@mysql:3306/exchange
DATABASE_URL=mysql://exchange:change-me@mysql:3306/exchange

# MongoDB 完整连接地址。管理员用户通常需要 authSource=admin。
# 示例：mongodb://exchange:change-me@mongodb:27017/?authSource=admin
MONGODB_URI=mongodb://exchange:change-me@mongodb:27017/?authSource=admin

# 业务使用的 MongoDB 数据库名称。
# 示例：exchange
MONGODB_DATABASE=exchange

# Redis 完整连接地址，末尾的 0 表示数据库编号。
# 示例：redis://:change-me@redis:6379/0
REDIS_URL=redis://:change-me@redis:6379/0

# RabbitMQ AMQP 地址，默认虚拟主机 / 需要编码为 %2f。
# 示例：amqp://exchange:change-me@rabbitmq:5672/%2f
RABBITMQ_URL=amqp://exchange:change-me@rabbitmq:5672/%2f

# JWT 签名密钥。请使用 openssl rand -hex 32 生成高强度随机值。
# 示例：change-me-jwt-secret-at-least-32-bytes
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes

# 凭据加密密钥。使用 openssl rand -hex 16 生成恰好 32 个 ASCII 字符。
# 保存过加密凭据后必须保持该值稳定，否则历史数据将无法解密。
# 示例：change-me-credential-key-32bytes
CREDENTIAL_ENCRYPTION_KEY=change-me-credential-key-32bytes

# Bitget REST 行情接口地址，通常保持官方默认值。
# 示例：https://api.bitget.com
BITGET_REST_BASE_URL=https://api.bitget.com

# Bitget WebSocket 行情接口地址，通常保持官方默认值。
# 示例：wss://ws.bitget.com/v2/ws/public
BITGET_WS_URL=wss://ws.bitget.com/v2/ws/public

# HTX REST 行情接口地址，通常保持官方默认值。
# 示例：https://api.huobi.pro
HTX_REST_BASE_URL=https://api.huobi.pro

# HTX WebSocket 行情接口地址，通常保持官方默认值。
# 示例：wss://api.huobi.pro/ws
HTX_WS_URL=wss://api.huobi.pro/ws

# API/容器重启时的行情订阅兜底。后台已保存并启用行情配置时，以后台配置为准。
# 多个交易对或周期使用英文逗号分隔；交易对需使用无分隔符格式。
MARKET_FEED_SYMBOLS=BTCUSDT
MARKET_FEED_INTERVALS=1m,5m,15m,1h,1d
MARKET_FEED_PROVIDERS=bitget

# Rust 日志级别。生产环境建议使用 info，需要排障时可临时改为 debug。
# 示例：info
RUST_LOG=info

# Cloudflare Turnstile：
# Site key 和 Secret 在 Cloudflare Turnstile 的同一 Widget 中获取（Site key 供前端，Secret 供后端）。
CF_TURNSTILE_SECRET=change-me-turnstile-secret
CF_TURNSTILE_SECRET_KEY=
CF_TURNSTILE_SITE_KEY=change-me-turnstile-site-key
CF_TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# 开启后端登录校验时，是否始终要求 cf_turnstile_token（即使请求携带 cf_clearance）；
# 生产建议开启为 true，避免存在 cf_clearance 时被跳过校验。
CF_TURNSTILE_ENFORCE_TOKEN=true

# Docker json-file 日志轮转：单个日志文件的最大大小。
# 示例：20m
LOG_MAX_SIZE=20m

# Docker json-file 日志轮转：最多保留的日志文件数量。
# 示例：5
LOG_MAX_FILE=5
