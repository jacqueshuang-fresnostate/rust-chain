{
  "name": "rust-chain-admin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && rm -f vite.config.js vite.config.d.ts && vite build",
    "typecheck": "tsc -b --pretty false && rm -f vite.config.js vite.config.d.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage src/admin/sharedOptionQuery.test.tsx src/api/marketTickerSocket.test.ts src/auth/authStore.test.ts src/config/backend.test.ts",
    "test:production-policy": "vitest run src/app/productionPolicy.test.ts src/config/backend.test.ts src/config/backend.same-origin.test.ts src/admin/access.test.tsx",
    "budget": "node ./scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.99.2",
    "@douyinfe/semi-ui": "^2.99.2",
    "@tanstack/react-query": "^5.100.14",
    "@types/numeral": "^2.0.5",
    "numeral": "^2.0.6",
    "quill": "^2.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
