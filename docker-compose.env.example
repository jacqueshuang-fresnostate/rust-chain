# Copy this file to docker-compose.env and replace every change-me value.
# Generate password values with `openssl rand -hex 32` so they remain URL-safe.

EXCHANGE_IMAGE=ghcr.io/jacqueshuang-fresnostate/rust-chain:latest
API_PORT=8080
RUST_LOG=info

MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_DATABASE=exchange
MYSQL_USER=exchange
MYSQL_PASSWORD=change-me-mysql-password

MONGO_INITDB_ROOT_USERNAME=exchange
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo-password
MONGODB_DATABASE=exchange

RABBITMQ_DEFAULT_USER=exchange
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password

JWT_SECRET=change-me-jwt-secret-at-least-32-bytes
# Generate this 32-character value with `openssl rand -hex 16`.
# It must stay stable after encrypting data.
CREDENTIAL_ENCRYPTION_KEY=change-me-credential-key-32bytes

BITGET_REST_BASE_URL=https://api.bitget.com
BITGET_WS_URL=wss://ws.bitget.com/v2/ws/public
HTX_REST_BASE_URL=https://api.huobi.pro
HTX_WS_URL=wss://api.huobi.pro/ws
