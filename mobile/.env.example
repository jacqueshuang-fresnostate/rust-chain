# 浏览器开发始终请求 Vite 同源地址；该变量只决定 Vite 把 HTTP/WebSocket 转发到哪里。
# 默认转发到产品后端；本地后端运行在 18080 时可改为 http://127.0.0.1:18080。
VITE_BACKEND_DEV_PROXY_TARGET=https://hipoex.cllbmz.kdns.fr

# PWA/Tauri 默认直连该产品后端；非空值优先覆盖内置默认值。
# 生产环境只能使用可访问的 HTTPS origin，不能使用 localhost 或 127.0.0.1。
VITE_BACKEND_API_DOMAIN=https://hipoex.cllbmz.kdns.fr
VITE_BACKEND_API_PREFIX=/api/v1

# PWA 的永久部署根路径。独立域名使用 /，子路径部署示例为 /mobile/。
# Tauri 构建会忽略该值并继续使用原生根路径。
VITE_PWA_BASE=/

# Cloudflare Turnstile：如已在 /auth/login 接口开启校验，需要提供公开站点密钥以渲染验证码。
VITE_CF_TURNSTILE_SITE_KEY=
