{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hippo Mobile",
  "version": "0.1.0",
  "identifier": "com.hippo.exchange.mobile",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1611",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hippo Mobile",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "base-uri": ["'self'"],
        "object-src": ["'none'"],
        "frame-ancestors": ["'none'"],
        "script-src": ["'self'", "https://challenges.cloudflare.com"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://hipoex.cllbmz.kdns.fr",
          "wss://hipoex.cllbmz.kdns.fr",
          "https://challenges.cloudflare.com"
        ],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "data:", "blob:", "https:"],
        "font-src": ["'self'", "data:", "blob:"],
        "frame-src": ["https://challenges.cloudflare.com"],
        "worker-src": ["'self'", "blob:"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
